{
  "name": "androidcontrolsystem",
  "version": "1.0.1",
  "description": "Android Multi-TV Deployment Suite",
  "main": "electron/main.js",
  "author": "Amit",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder",
    "dist": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --win",
    "win32-setup": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 electron-builder --win nsis"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.nextview.androidcontrolsystem",
    "productName": "Android Control System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    }
  }
}